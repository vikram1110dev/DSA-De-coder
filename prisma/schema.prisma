generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  password         String?
  avatar           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  profile          Profile?
  streak           UserStreak?
  activities       DSAActivity[]
  submissions      Submission[]
  studyPlans       StudyPlan[]
  reminders        Reminder[]
  notifications    Notification[]
  bookmarks        Bookmark[]
  notes            Note[]
  chatMessages     ChatMessage[]
  achievements     UserAchievement[]
  revisions        RevisionSchedule[]
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dsaLevel         String   @default("beginner") // beginner, intermediate, advanced
  language         String   @default("javascript") // javascript, python, java, cpp
  dailyStudyTime   Int      @default(30) // in minutes
  goal             String   @default("interviews") // placements, interviews, college, cp, skills
  targetDays       Int      @default(60) // 30, 60, 90
  preferredTime    String   @default("19:00") // 7:00 PM
  aiMode           String   @default("standard") // beginner, standard, deep-dive, interview
  xp               Int      @default(0)
  level            Int      @default(1)
  streakFreeze     Int      @default(2)
  quietHoursStart  String   @default("22:00")
  quietHoursEnd    String   @default("07:00")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserStreak {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  totalActiveDays  Int       @default(0)
  lastActiveDate   String?   // YYYY-MM-DD
  updatedAt        DateTime  @updatedAt
}

model DSAActivity {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String   // YYYY-MM-DD
  activityType     String   // LESSON_COMPLETED, VISUALIZATION_COMPLETED, PROBLEM_SOLVED, STUDY_SESSION, REVISION_COMPLETED, AI_CHALLENGE, MOCK_INTERVIEW
  activityScore    Int      @default(1)
  referenceId      String?
  metadata         String?  // JSON string
  createdAt        DateTime @default(now())
}

model Submission {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId        String
  code             String
  language         String
  status           String   // ACCEPTED, WRONG_ANSWER, TIME_LIMIT, COMPILE_ERROR
  passedCount      Int
  totalCount       Int
  timeTakenMs      Int?
  confidenceLevel  String?  // not_confident, somewhat_confident, very_confident
  createdAt        DateTime @default(now())
}

model StudyPlan {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  targetDate       DateTime?
  status           String      @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  tasks            StudyTask[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model StudyTask {
  id               String    @id @default(cuid())
  planId           String
  plan             StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayNumber        Int
  topicId          String
  title            String
  description      String?
  estimatedMinutes Int       @default(20)
  xpReward         Int       @default(15)
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  dateScheduled    String?   // YYYY-MM-DD
}

model Reminder {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  type             String   // study, practice, revision, mock_interview, custom
  time             String   // HH:mm
  date             String?  // YYYY-MM-DD for one-off
  repeatType       String   @default("daily") // daily, weekdays, weekends, weekly, none
  notificationType String   @default("browser") // in_app, browser, sound
  isEnabled        Boolean  @default(true)
  isDismissed      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Notification {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  message          String
  type             String   // reminder, streak, achievement, recommendation, revision
  linkUrl          String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Bookmark {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType         String   // problem, lesson, visualizer, explanation
  itemId           String
  title            String
  metadata         String?  // JSON string
  createdAt        DateTime @default(now())
}

model Note {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId          String
  title            String
  content          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ChatMessage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String   // user, assistant, system
  content          String
  metadata         String?  // JSON string
  createdAt        DateTime @default(now())
}

model UserAchievement {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId    String
  unlockedAt       DateTime @default(now())
}

model RevisionSchedule {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId          String
  intervalDay      Int      // 1, 3, 7, 14, 30
  dueDate          String   // YYYY-MM-DD
  isCompleted      Boolean  @default(false)
  completedAt      DateTime?
  createdAt        DateTime @default(now())
}
