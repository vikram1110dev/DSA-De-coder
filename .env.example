# DSA De-coder Environment Variables
# Google Gemini API Key (Server-side only - never exposed to frontend)
GEMINI_API_KEY=

# Database URL (SQLite for local zero-config, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Next.js Environment
NEXT_PUBLIC_APP_NAME="DSA De-coder"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
